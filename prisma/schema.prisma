generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  phone        String?
  fullName     String?
  alias        String?
  birthDate    DateTime? @db.Date
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tables        Table[]
  sessions      Session[]
  authoredTasks Task[]  @relation("TaskAuthor")
  assignedTasks Task[]  @relation("TaskAssignee")

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
  @@map("auth_rate_limits")
}

model Table {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  color       String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  completionColumnId String? @unique
  completionColumn Column? @relation("CompletionColumn", fields: [completionColumnId], references: [id], onDelete: SetNull)
  columns Column[]

  @@index([ownerId])
  @@map("tables")
}

model Column {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  color       String?
  position    Int      @default(0)
  tableId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  table Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  completionFor Table? @relation("CompletionColumn")
  tasks Task[]

  @@index([tableId])
  @@map("columns")
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  color       String?
  position    Int      @default(0)
  columnId    String
  authorId    String
  assigneeId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  endDate     DateTime? @db.Date
  completedAt DateTime?

  priorityId String @default("none")
  priority Priority @relation(fields: [priorityId], references: [id], onDelete: Restrict)
  tags     TaskTag[]
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
  author   User   @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  assignee User?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([priorityId])
  @@index([columnId])
  @@map("tasks")
}

model TaskTag {
  id       String @id @default(cuid())
  taskId   String
  label    String @db.VarChar(30)
  color    String?
  position Int
  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, position])
  @@map("task_tags")
}

model Priority {
  id String @id
  name String
  position Int @unique
  tasks Task[]

  @@map("priorities")
}
